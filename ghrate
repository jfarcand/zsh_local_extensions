#!/usr/bin/env bash
# ghrate - Show GitHub API rate limit status and when it resets (EDT)
#
# Usage:
#   ghrate                       # show all resource buckets
#   ghrate core                  # show only the "core" bucket
#   ghrate -w [SECONDS]          # watch mode, refresh every N seconds (default 30)
#   ghrate --burn [SECONDS]      # measure burn rate over N seconds (default 10)
#   ghrate --threshold N         # alert below N remaining (default 1000)
#   ghrate --alert-bucket NAME   # bucket to alert on (default: core, or filter)
#   ghrate --no-alert            # disable sound + macOS notification on alerts
#   ghrate --callers             # also snapshot local processes with open TCP to GitHub
#   ghrate --callers-only        # only show the callers snapshot (skip rate-limit)
#
# Note: gh api rate_limit does NOT count against any bucket — safe to poll.

set -euo pipefail

WATCH=false
WATCH_INTERVAL=30
WATCH_MAX_SECONDS=21600   # auto-exit watch after 6h so a forgotten loop can't linger
BURN=false
BURN_INTERVAL=10
FILTER=""
THRESHOLD=1000
ALERT_BUCKET=""
ALERT_ENABLED=true
CALLERS=false
CALLERS_ONLY=false
declare -A PREV_USED
declare -A ALERT_FIRED

while [[ $# -gt 0 ]]; do
  case "$1" in
    -w|--watch)
      WATCH=true
      if [[ "${2:-}" =~ ^[0-9]+$ ]]; then
        WATCH_INTERVAL="$2"
        shift
      fi
      shift
      ;;
    --burn)
      BURN=true
      if [[ "${2:-}" =~ ^[0-9]+$ ]]; then
        BURN_INTERVAL="$2"
        shift
      fi
      shift
      ;;
    --threshold)
      if [[ "${2:-}" =~ ^[0-9]+$ ]]; then
        THRESHOLD="$2"
        shift 2
      else
        echo "ghrate: --threshold requires a number" >&2
        exit 1
      fi
      ;;
    --alert-bucket)
      ALERT_BUCKET="${2:-}"
      shift 2
      ;;
    --no-alert)
      ALERT_ENABLED=false
      shift
      ;;
    --callers)
      CALLERS=true
      shift
      ;;
    --callers-only)
      CALLERS=true
      CALLERS_ONLY=true
      shift
      ;;
    -h|--help)
      sed -n '2,15p' "$0" | sed 's/^# \?//'
      exit 0
      ;;
    *)
      FILTER="$1"
      shift
      ;;
  esac
done

GREEN='\033[0;32m'
YELLOW='\033[0;33m'
RED='\033[0;31m'
BOLD='\033[1m'
DIM='\033[2m'
RESET='\033[0m'

# Format an epoch as EDT (America/New_York) plus a human delta from now.
format_reset() {
  local epoch="$1"
  local now delta sign abs_delta hrs mins secs when_str delta_str
  now=$(date +%s)
  delta=$(( epoch - now ))
  if (( delta < 0 )); then
    sign="-"
    abs_delta=$(( -delta ))
  else
    sign=""
    abs_delta=$delta
  fi
  hrs=$(( abs_delta / 3600 ))
  mins=$(( (abs_delta % 3600) / 60 ))
  secs=$(( abs_delta % 60 ))

  if (( hrs > 0 )); then
    delta_str=$(printf "%s%dh%02dm%02ds" "$sign" "$hrs" "$mins" "$secs")
  elif (( mins > 0 )); then
    delta_str=$(printf "%s%dm%02ds" "$sign" "$mins" "$secs")
  else
    delta_str=$(printf "%s%ds" "$sign" "$secs")
  fi

  # America/New_York gives EDT in summer, EST in winter — labelled by %Z.
  when_str=$(TZ="America/New_York" date -r "$epoch" "+%Y-%m-%d %H:%M:%S %Z")
  echo "${when_str} (in ${delta_str})"
}

print_bucket() {
  local name="$1" limit="$2" used="$3" remaining="$4" reset="$5" delta="${6:-}"
  local color when

  if (( remaining == 0 )); then
    color="$RED"
  elif (( remaining < limit / 10 )); then
    color="$YELLOW"
  else
    color="$GREEN"
  fi

  when=$(format_reset "$reset")

  if [[ -n "$delta" ]]; then
    printf "${BOLD}%-22s${RESET} ${color}%5d / %-5d remaining${RESET}  ${DIM}used %-5d${RESET}  %b  resets ${BOLD}%s${RESET}\n" \
      "$name" "$remaining" "$limit" "$used" "$delta" "$when"
  else
    printf "${BOLD}%-22s${RESET} ${color}%5d / %-5d remaining${RESET}  ${DIM}used %-5d${RESET}  resets ${BOLD}%s${RESET}\n" \
      "$name" "$remaining" "$limit" "$used" "$when"
  fi
}

fire_alert() {
  local name="$1" remaining="$2" limit="$3"
  if command -v afplay >/dev/null 2>&1; then
    afplay /System/Library/Sounds/Sosumi.aiff >/dev/null 2>&1 &
  fi
  if command -v osascript >/dev/null 2>&1; then
    osascript -e "display notification \"${name}: ${remaining}/${limit} remaining\" with title \"ghrate: low rate limit\" sound name \"Sosumi\"" >/dev/null 2>&1 || true
  fi
}

show_callers() {
  # Snapshot local TCP sockets to GitHub IPs and aggregate by PID.
  # GitHub's published CIDR blocks for api/web: 140.82.112.0/20, 192.30.252.0/22,
  # 185.199.108.0/22, 143.55.64.0/20. We also resolve api/codeload/github at runtime
  # to catch IPs outside those blocks.
  local gh_ips=""
  if command -v dig >/dev/null 2>&1; then
    gh_ips=$(dig +short +time=1 +tries=1 api.github.com codeload.github.com github.com 2>/dev/null \
      | grep -E '^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$' | sort -u)
  elif command -v host >/dev/null 2>&1; then
    gh_ips=$(for h in api.github.com codeload.github.com github.com; do
      host "$h" 2>/dev/null | awk '/has address/{print $4}'
    done | sort -u)
  fi

  local prefix_regex='->(140\.82\.|192\.30\.|185\.199\.|143\.55\.)'
  local ip_regex=""
  if [[ -n "$gh_ips" ]]; then
    ip_regex=$(echo "$gh_ips" | sed 's/\./\\./g' | tr '\n' '|' | sed 's/|$//')
    ip_regex="->(${ip_regex}):"
  fi

  local combined_regex="$prefix_regex"
  [[ -n "$ip_regex" ]] && combined_regex="(${prefix_regex}|${ip_regex})"

  printf "\n${BOLD}── callers (TCP to GitHub) ──${RESET}\n"

  local lsof_out
  lsof_out=$(lsof -i -n -P -sTCP:ESTABLISHED 2>/dev/null | awk '/:443/' || true)
  if [[ -z "$lsof_out" ]]; then
    printf "  ${DIM}(no ESTABLISHED :443 sockets visible — try sudo for system sockets)${RESET}\n"
    return 0
  fi

  local matches
  matches=$(echo "$lsof_out" | grep -E "$combined_regex" || true)
  if [[ -z "$matches" ]]; then
    printf "  ${DIM}(no active connections to GitHub IPs)${RESET}\n"
    return 0
  fi

  local agg
  agg=$(echo "$matches" | awk '{
      cmd=$1; pid=$2; user=$3
      count[pid]++
      cmds[pid]=cmd
      users[pid]=user
    }
    END {
      for (p in count) printf "%d\t%s\t%s\t%d\n", p, cmds[p], users[p], count[p]
    }' | sort -t$'\t' -k4 -rn)

  printf "${DIM}%-6s %-18s %-14s %-5s %-9s %s${RESET}\n" "PID" "COMMAND" "USER" "CONN" "AGE" "FULL CMD"
  local pid cmd user conns etime full_cmd
  while IFS=$'\t' read -r pid cmd user conns; do
    etime=$(ps -o etime= -p "$pid" 2>/dev/null | tr -d ' ')
    [[ -z "$etime" ]] && etime="?"
    full_cmd=$(ps -ww -o command= -p "$pid" 2>/dev/null | cut -c1-72)
    [[ -z "$full_cmd" ]] && full_cmd="(gone)"
    printf "${BOLD}%-6s${RESET} %-18s ${DIM}%-14s${RESET} ${BOLD}%4d${RESET}  %-9s %s\n" \
      "$pid" "$cmd" "$user" "$conns" "$etime" "$full_cmd"
  done <<< "$agg"
}

show_status() {
  local json
  if ! json=$(gh api rate_limit 2>/dev/null); then
    echo "ghrate: failed to call 'gh api rate_limit' — is gh installed and authenticated?" >&2
    return 1
  fi

  local now_str
  now_str=$(TZ="America/New_York" date "+%Y-%m-%d %H:%M:%S %Z")
  printf "${DIM}as of %s${RESET}\n" "$now_str"

  local jq_filter='.resources | to_entries[] | "\(.key)\t\(.value.limit)\t\(.value.used)\t\(.value.remaining)\t\(.value.reset)"'

  local target_bucket="${ALERT_BUCKET:-${FILTER:-core}}"

  while IFS=$'\t' read -r name limit used remaining reset; do
    if [[ -n "$FILTER" && "$name" != "$FILTER" ]]; then
      continue
    fi

    local delta_field=""
    local prev="${PREV_USED[$name]:-}"
    if [[ -n "$prev" ]]; then
      local d=$(( used - prev ))
      if (( d > 0 )); then
        delta_field="${RED}${BOLD}Δ +${d}${RESET}"
      elif (( d < 0 )); then
        delta_field="${DIM}Δ ${d}${RESET}"
      else
        delta_field="${DIM}Δ 0${RESET}"
      fi
    fi
    PREV_USED[$name]=$used

    print_bucket "$name" "$limit" "$used" "$remaining" "$reset" "$delta_field"

    if [[ "$name" == "$target_bucket" ]]; then
      if (( remaining < THRESHOLD )); then
        printf "  ${RED}${BOLD}⚠ %s below threshold (%d < %d)${RESET}\n" "$name" "$remaining" "$THRESHOLD"
        if $ALERT_ENABLED && [[ -z "${ALERT_FIRED[$name]:-}" ]]; then
          fire_alert "$name" "$remaining" "$limit"
          ALERT_FIRED[$name]=1
        fi
      else
        unset 'ALERT_FIRED[$name]' || true
      fi
    fi
  done < <(echo "$json" | jq -r "$jq_filter")
}

fetch_used() {
  # Print "name<TAB>used<TAB>limit<TAB>remaining<TAB>reset" for each bucket.
  gh api rate_limit 2>/dev/null \
    | jq -r '.resources | to_entries[] | "\(.key)\t\(.value.used)\t\(.value.limit)\t\(.value.remaining)\t\(.value.reset)"'
}

show_burn() {
  local target="${FILTER:-core}"
  local snap1 snap2 t1 t2 used1 used2 lim rem2 reset2 delta rate eta_sec eta_str

  printf "${DIM}sampling '%s' over %ds…${RESET}\n" "$target" "$BURN_INTERVAL"
  snap1=$(fetch_used) || { echo "ghrate: gh api rate_limit failed" >&2; return 1; }
  t1=$(date +%s)
  sleep "$BURN_INTERVAL"
  snap2=$(fetch_used) || { echo "ghrate: gh api rate_limit failed" >&2; return 1; }
  t2=$(date +%s)

  used1=$(echo "$snap1" | awk -v t="$target" -F'\t' '$1==t{print $2}')
  read -r used2 lim rem2 reset2 < <(echo "$snap2" | awk -v t="$target" -F'\t' '$1==t{print $2"\t"$3"\t"$4"\t"$5}')

  if [[ -z "$used1" || -z "$used2" ]]; then
    echo "ghrate: bucket '$target' not found" >&2
    return 1
  fi

  delta=$(( used2 - used1 ))
  local elapsed=$(( t2 - t1 ))
  (( elapsed == 0 )) && elapsed=1

  # Rate in requests/sec, two decimals via awk
  rate=$(awk -v d="$delta" -v e="$elapsed" 'BEGIN{printf "%.2f", d/e}')

  printf "${BOLD}%s${RESET}: ${BOLD}%d${RESET} requests in ${BOLD}%ds${RESET}  →  ${BOLD}%s req/s${RESET}  (${DIM}%.1f req/min${RESET})\n" \
    "$target" "$delta" "$elapsed" "$rate" "$(awk -v r="$rate" 'BEGIN{print r*60}')"

  if (( delta > 0 && rem2 > 0 )); then
    eta_sec=$(awk -v r="$rem2" -v rate="$rate" 'BEGIN{ if(rate>0) printf "%d", r/rate; else print 999999 }')
    if (( eta_sec < 999999 )); then
      local eta_h=$(( eta_sec / 3600 ))
      local eta_m=$(( (eta_sec % 3600) / 60 ))
      local eta_s=$(( eta_sec % 60 ))
      if (( eta_h > 0 )); then
        eta_str=$(printf "%dh%02dm%02ds" "$eta_h" "$eta_m" "$eta_s")
      else
        eta_str=$(printf "%dm%02ds" "$eta_m" "$eta_s")
      fi
      local exhaust_epoch=$(( t2 + eta_sec ))
      local exhaust_when
      exhaust_when=$(TZ="America/New_York" date -r "$exhaust_epoch" "+%H:%M:%S %Z")
      printf "at this rate, ${BOLD}%d${RESET} remaining exhaust in ${BOLD}%s${RESET} (≈ %s)\n" \
        "$rem2" "$eta_str" "$exhaust_when"
    fi
  fi

  printf "window resets %s\n" "$(format_reset "$reset2")"
}

if $BURN; then
  show_burn
elif $WATCH; then
  # Render into the alternate screen buffer so periodic refreshes never
  # accumulate in terminal scrollback (this is what lets iTerm grow without
  # bound over a long watch). Restore the primary screen on any exit, and
  # auto-stop after WATCH_MAX_SECONDS so a forgotten watch can't run for days.
  trap 'printf "\033[?1049l"' EXIT
  printf '\033[?1049h'
  watch_deadline=$(( $(date +%s) + WATCH_MAX_SECONDS ))
  while true; do
    printf '\033[H\033[2J'
    $CALLERS_ONLY || show_status || true
    $CALLERS && show_callers || true
    if (( $(date +%s) >= watch_deadline )); then
      printf "\n${DIM}auto-exited after %ds — re-run to keep watching${RESET}\n" "$WATCH_MAX_SECONDS"
      break
    fi
    printf "\n${DIM}refreshing every %ds — Ctrl-C to stop${RESET}\n" "$WATCH_INTERVAL"
    sleep "$WATCH_INTERVAL"
  done
else
  $CALLERS_ONLY || show_status
  $CALLERS && show_callers || true
fi
