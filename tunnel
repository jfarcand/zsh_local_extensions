#!/bin/zsh
# tunnel: forward localhost ports from this Mac to the remote Mac (ssh alias
# ccc-remote, or $CCC_HOST) and hold until Ctrl-C.
# `tunnel 57857 8090` forwards those ports; bare `tunnel` finds the callback
# port of every pending Claude Code /login on the remote Mac (a Claude process,
# named `claude` or after its version `2.1.*`, listening on a loopback port; it
# listens on nothing else) so the browser redirect on this Mac reaches it. The
# forward targets `localhost`, which reaches an IPv4 or an IPv6 listener.
# `@<ssh alias>` anywhere in the arguments picks another remote Mac, as in ccc
host=${CCC_HOST:-ccc-remote}
ports=()
for a in "$@"; do
  case "$a" in
    @?*) host=${a#@} ;;
    *) ports+=("$a") ;;
  esac
done
if (( ${#ports} == 0 )); then
  ports=(${(f)"$(ssh -o BatchMode=yes $host "lsof -nP -a -iTCP -sTCP:LISTEN -c claude -c 2.1. -Fn 2>/dev/null | sed -nE 's/^n(127\\.0\\.0\\.1|\\[::1\\]|localhost):([0-9]+)\$/\\2/p' | sort -u")"})
  if (( ${#ports} == 0 )); then
    echo "No pending Claude login on $host. Pass the port from the browser URL: tunnel <port>"
    exit 1
  fi
fi
forwards=()
for p in $ports; do
  [[ "$p" == <1-65535> ]] || { echo "Not a port: $p"; exit 1; }
  forwards+=(-L "${p}:localhost:${p}")
done
echo "Tunnel to $host open on port(s): ${(j:, :)ports}. Ctrl-C to close."
trap 'echo "\nTunnel closed."' INT
ssh -N -o ExitOnForwardFailure=yes -o ServerAliveInterval=15 $forwards $host
