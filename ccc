#!/bin/zsh
# ccc: open a Claude Code tmux pane on the remote Mac (ssh alias ccc-remote,
# or $CCC_HOST) from this one.
#   ccc            reconnect this iTerm pane to the Claude conversation it
#                  showed (by id, then name; resumed if no Claude runs it any
#                  more), else the session menu
#   ccc list       the session menu; Enter starts a new work-account session
#   ccc new        a new work-account session, no menu
#   ccc <account>  with list/new: bind a new session to Claude account
#                  <account> (oss -> ~/.claude-perso, any other name ->
#                  ~/.claude-<account> on the remote Mac)
#   ccc switch <account>  resume this pane's conversation on another account,
#                  in a fresh session (exit Claude first: one conversation,
#                  one running Claude)
#   ccc resume <id> [<account>]  reattach, or resume, a saved conversation by
#                  id or id prefix (e.g. one no pane shows any more)
#   ccc <n>        attach tmux session n directly
#   ccc recover    open an iTerm tab for every Claude session on the remote
#                  Mac that no live pane here is showing (after drops, sleep,
#                  a restart)
# Unlocks the remote login keychain first: every SSH session starts with it
# locked (the unlock is per session), which makes claude report "Not logged
# in". The password comes from this Mac's keychain item $CCC_KEYCHAIN_ITEM
# (default "ccc-remote-login") and rides in the LC_CCC_KC env var (the remote
# sshd accepts LC_*), never argv; the remote side unsets it before tmux starts.
# Without the item, the remote Mac prompts for it.
# ~/.local/bin/ccc-tmux on the remote Mac does the rest; it tells a live pane
# from a stale one by the source ports of this Mac's SSH connections
# (LC_CCC_PORTS). The remote Mac tags each iTerm pane with the conversation it
# shows (iTerm variable user.cccClaude, set by ~/.local/bin/ccc-tag there, kept
# by iTerm after the connection dies); ccc sends that tag (LC_CCC_CLAUDE) to
# reconnect by it. When the connection drops, ccc reconnects until Ctrl-C.
host=${CCC_HOST:-ccc-remote}

# Source ports of this Mac's established SSH connections
live_ports() {
  lsof -nP -a -c ssh -iTCP:22 -sTCP:ESTABLISHED 2>/dev/null \
    | awk 'NR > 1 { split($9, a, "->"); n = split(a[1], b, ":"); print b[n] }' \
    | sort -u | paste -sd, -
}

# This iTerm pane's cccClaude tag, base64 for the trip over SSH; empty when
# the pane never showed a remote session
pane_tag() {
  local id=${ITERM_SESSION_ID#*:}
  [[ -z "$id" ]] && return
  osascript -e 'on run argv' -e 'tell application "iTerm2"' \
    -e 'repeat with w in windows' -e 'repeat with t in tabs of w' -e 'repeat with s in sessions of t' \
    -e 'if unique id of s is item 1 of argv then return (variable named "user.cccClaude") of s' \
    -e 'end repeat' -e 'end repeat' -e 'end repeat' -e 'end tell' -e 'end run' "$id" 2>/dev/null \
    | grep -v '^missing value$' | tr -d '\n' | base64
}

export LC_CCC_ACCOUNT=work LC_CCC_ATTACH= LC_CCC_MODE= LC_CCC_RESUME=
account_given=false
if [[ "$1" == resume ]]; then
  [[ -n "$2" ]] || { echo "usage: ccc resume <conversation id or prefix> [<account>]"; exit 1; }
  LC_CCC_MODE=resume LC_CCC_RESUME=$2
  shift 2
fi
for arg in "$@"; do case "$arg" in
  work) account_given=true ;;
  list|new|switch) LC_CCC_MODE=$arg ;;
  <->) LC_CCC_ATTACH=$arg ;;
  recover)
    LC_CCC_PORTS=$(live_ports) LC_CCC_MODE=tsv ssh -o BatchMode=yes \
      -o SendEnv=LC_CCC_PORTS -o SendEnv=LC_CCC_MODE $host .local/bin/ccc-tmux \
      | while IFS=$'\t' read -r n acct state here bilan title; do
          [[ "$state" == shell || "$here" == yes ]] && continue
          echo "Reopening session $n ($acct, bilan $bilan, $state): $title"
          osascript -e 'tell application "iTerm2" to tell current window' \
            -e 'set t to (create tab with default profile)' \
            -e "tell current session of t to write text \"ccc $n\"" \
            -e 'end tell' </dev/null >/dev/null
        done
    exit 0 ;;
  [a-z]*([a-z0-9-])) LC_CCC_ACCOUNT=$arg account_given=true ;;
  *) echo "usage: ccc [list | new | switch | <session> | recover] [<account>]"; exit 1 ;;
esac; done
if [[ "$LC_CCC_MODE" == switch ]] && ! $account_given; then
  echo "usage: ccc switch <account>   (work, oss, or the x of ~/.claude-x)"
  exit 1
fi

LC_CCC_KC=$(security find-generic-password -a "$USER" -s "${CCC_KEYCHAIN_ITEM:-ccc-remote-login}" -w 2>/dev/null)
export LC_CCC_KC

# The remote Mac paints the pane in its tmux session's colour on attach; leaving ccc
# gives the pane its own colours back
reset_colours() { printf '\033]6;1;bg;*;default\a\033]111\a' }

# tmux and Claude Code switch the terminal into extended-key, mouse,
# focus-event and bracketed-paste modes; a connection that dies abruptly never
# switches them back, and Ctrl-C then arrives as ESC[27;5;99~ that nothing
# here reads as an interrupt. Put the terminal back after every connection.
reset_terminal() {
  printf '\033[>4;0m\033[<u\033[?1004l\033[?2004l\033[?1000l\033[?1002l\033[?1003l\033[?1006l\033[?25h'
}
remote='
kc=$HOME/Library/Keychains/login.keychain-db
if ! security show-keychain-info "$kc" >/dev/null 2>&1; then
  if [ -z "$LC_CCC_KC" ] || ! printf "unlock-keychain -p %s %s\n" "$(printf %q "$LC_CCC_KC")" "$kc" | security -i >/dev/null 2>&1; then
    echo "The remote login keychain is locked; unlocking it for Claude Code."
    security unlock-keychain "$kc" || exit 1
  fi
fi
unset LC_CCC_KC
exec $HOME/.local/bin/ccc-tmux
'
while true; do
  LC_CCC_PORTS=$(live_ports) LC_CCC_CLAUDE=$(pane_tag)
  export LC_CCC_PORTS LC_CCC_CLAUDE
  ssh -t -o ConnectTimeout=10 -o SendEnv=LC_CCC_KC -o SendEnv=LC_CCC_ACCOUNT -o SendEnv=LC_CCC_ATTACH \
    -o SendEnv=LC_CCC_PORTS -o SendEnv=LC_CCC_MODE -o SendEnv=LC_CCC_CLAUDE -o SendEnv=LC_CCC_RESUME $host "$remote"
  # 0 is a detach or an ended session, 130 a Ctrl-C at the menu; anything
  # else (255 connection lost, a killed ssh) reconnects
  rc=$?
  reset_terminal
  (( rc == 0 || rc == 130 )) && { reset_colours; exit $rc }
  # The pane's tag names the conversation, so reconnecting lands back in it
  LC_CCC_ATTACH= LC_CCC_MODE= LC_CCC_RESUME=
  print -P "%F{yellow}Connection to $host lost; reconnecting in 5 s (Ctrl-C to stop)...%f"
  sleep 5 || { reset_colours; exit 0 }
done
