#!/usr/bin/osascript -l JavaScript
// clip-to-remote: copy every image put on this Mac's clipboard to the remote
// Mac's clipboard (ssh alias ccc-remote, or $CCC_HOST), so pasting it in
// Claude Code running there (over ccc) works. Universal Clipboard does not
// deliver reliably while the remote Mac's screen sleeps or is locked.
// Runs under the local.clip-to-remote LaunchAgent; the remote ~/.local/bin/clip-set-png
// receives the PNG on stdin. Text is left alone: the terminal pastes it.
ObjC.import('AppKit');

const app = Application.currentApplication();
app.includeStandardAdditions = true;
const pasteboard = $.NSPasteboard.generalPasteboard;
const png = $.NSTemporaryDirectory().js + 'clip-to-remote.png';
const host = $.NSProcessInfo.processInfo.environment.objectForKey('CCC_HOST').js || 'ccc-remote';
let last = pasteboard.changeCount;
// Universal Clipboard can echo the remote copy back here; never resend the same image
let sent = null;

// PNG bytes of the clipboard image, converting TIFF (screenshots, many apps)
function clipboardPng() {
  let data = pasteboard.dataForType($.NSPasteboardTypePNG);
  if (!data.isNil()) return data;
  const tiff = pasteboard.dataForType($.NSPasteboardTypeTIFF);
  if (tiff.isNil()) return null;
  return $.NSBitmapImageRep.imageRepWithData(tiff)
    .representationUsingTypeProperties($.NSBitmapImageFileTypePNG, $());
}

while (true) {
  delay(1);
  const count = pasteboard.changeCount;
  if (count === last) continue;
  last = count;
  const data = clipboardPng();
  if (!data || (sent && data.isEqualToData(sent))) continue;
  sent = data;
  data.writeToFileAtomically(png, true);
  try {
    app.doShellScript(
      "/usr/bin/ssh -o BatchMode=yes -o ConnectTimeout=5 " + host + " .local/bin/clip-set-png < '" + png + "'");
  } catch (e) {
    console.log('clip-to-remote: ' + host + ' unreachable, image not sent: ' + e);
  }
}
